        "de": "Praktisch: Labor, Hardware, Integration"
      },
      "b": {
        "en": "Desk work: analysis, models, software",
        "de": "Am Schreibtisch: Analyse, Modelle, Software"
      },
      "a_regex": "hands-on|laborator\\w*|lab\\b|cleanroom|reinraum|assembly|integration and test|test bench|prüfstand|soldering|werkstatt|workshop|montage|harness",
      "b_regex": "simulation\\w*|modell?ing|analys[ie]s|algorithm\\w*|software development|data science|machine learning|python|statistic\\w*|numerical|cfd|fem\\b"
    },
    {
      "id": "research",
      "a": {
        "en": "New things: research, prototypes",
        "de": "Neues: Forschung, Prototypen"
      },
      "b": {
        "en": "Delivery: production, operations",
        "de": "Umsetzung: Produktion, Betrieb"
      },
      "a_regex": "research|phd|prototyp\\w*|forschung\\w*|state-of-the-art|publications?|proof of concept|feasibility|experiment\\w*|scientific",
      "b_regex": "series production|serienfertigung|production line|manufacturing operations|operations|maintenance|wartung|instandhaltung|shift|schicht\\w*|ramp-up|yield"
    },
    {
      "id": "customer",
      "a": {
        "en": "With customers and partners",
        "de": "Mit Kunden und Partnern"
      },
      "b": {
        "en": "Inside the technical team",
        "de": "Im technischen Team"
      },
      "a_regex": "customers?\\b|client\\w*|kunden\\w*|stakeholder\\w*|presentations?|sales|business development|vertrieb|proposal\\w*|negotiat\\w*",
      "b_regex": "firmware|schematic\\w*|pcb|fpga|code reviews?|unit tests?|cad\\b|catia|nx\\b|solidworks|matlab|verilog|vhdl"
    },
    {
      "id": "defence",
      "a": {
        "en": "Defence and security",
        "de": "Verteidigung und Sicherheit"
      },
      "b": {
        "en": "Civil, commercial and science",
        "de": "Zivil, kommerziell und Wissenschaft"
      },
      "a_regex": "defen[cs]e|military|militär\\w*|bundeswehr|security clearance|sicherheitsüberprüfung|nato|armed forces|weapon\\w*|rüstung",
      "b_regex": "earth observation|scientific|science mission|commercial customers|telecommunication\\w*|climate|civil aviation|consumer"
    }
