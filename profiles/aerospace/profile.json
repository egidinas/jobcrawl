  "levels": [
    {
      "code": "student",
      "rank": 0,
      "label": {
        "en": "Student & intern",
        "de": "Student & Praktikum"
      },
      "pattern": "\\b(intern(ship)?|praktik\\w*|werkstudent\\w*|working student|thesis|abschlussarbeit|bachelorarbeit|masterarbeit|trainee|apprentice\\w*|ausbildung|azubi|duales studium|dual student|student)\\b"
    },
    {
      "code": "lead",
      "rank": 4,
      "label": {
        "en": "Lead & management",
        "de": "Leitung & Management"
      },
      "pattern": "\\b(head of|director|vp|vice president|chief|cto|coo|ceo|manager|management|\\w*leiter\\w*|team ?lead\\w*|lead|principal investigator|general manager|geschäftsführ\\w*)\\b"
    },
    {
      "code": "senior",
      "rank": 3,
      "label": {
        "en": "Senior & principal",
        "de": "Senior & Principal"
      },
      "pattern": "\\b(senior|sr\\.?|principal|staff|expert\\w*|experte|architect|fellow)\\b"
    },
    {
      "code": "entry",
      "rank": 1,
      "label": {
        "en": "Entry level",
        "de": "Berufseinstieg"
      },
      "pattern": "\\b(junior|jr\\.?|graduate|entry[- ]level|berufseinsteiger\\w*|absolvent\\w*|early career|associate)\\b"
    },
    {
      "code": "mid",
      "rank": 2,
      "label": {
        "en": "Engineer & specialist",
        "de": "Ingenieur & Fachkraft"
      },
      "pattern": null
    }
  ],
  "statements": [
    {
      "id": "autonomy",
      "a": {
        "en": "Independent work, own decisions",
        "de": "Selbstständiges Arbeiten, eigene Entscheidungen"
      },
      "b": {
        "en": "Clear guidelines and processes",
        "de": "Klare Vorgaben und Prozesse"
      },
      "a_regex": "independent(ly)?|work independently|ownership|self-driven|self-starter|greenfield|from scratch|eigenverantwortlich\\w*|selbstständig\\w*|selbständig\\w*|entrepreneur\\w*|ambiguity",
      "b_regex": "procedures?|complian\\w*|regulat\\w*|audits?|certification|quality management|work instructions?|richtlinien|vorgaben|verfahrensanweisung\\w*|normen|iso 9001|en 9100|as9100"
    },
    {
      "id": "handson",
